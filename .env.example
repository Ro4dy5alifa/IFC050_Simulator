# IFC050 Simulator configuration
# Copy this file to .env and adjust as needed.

# Modbus TCP server listen port (router connects here)
MODBUS_PORT=502

# Modbus TCP bind address (0.0.0.0 = all interfaces)
MODBUS_HOST=0.0.0.0

# Web UI port
WEB_PORT=8081

# Number of flowmeters on first start. Change it later in the web UI; after that
# the saved state file decides. Meters 1-247 use MODBUS_PORT (unit IDs 1-247),
# meters 248-494 use MODBUS_PORT+1 (unit IDs 1-247), and so on.
METER_COUNT=3

# Upper limit for the meter count set from the UI
MAX_METERS=2000

# Unit IDs per TCP port (1-247)
UNITS_PER_PORT=247

# Where settings are saved (default: simulator-state.json next to server.js)
# STATE_FILE=
